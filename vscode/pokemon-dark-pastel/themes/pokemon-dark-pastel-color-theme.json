	"tokenColors": [
		{
			"scope": ["comment"],
			"settings": { "foreground": "#8290B5", "fontStyle": "italic" }
		},
		{
			// keyword, storage, control flow.
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.logical",
				"variable.language.this"
			],
			"settings": { "foreground": "#9AA6F0" }
		},
		{
			// Строки.
			"scope": ["string", "string.quoted"],
			"settings": { "foreground": "#98D08C" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character.escape"],
			"settings": { "foreground": "#F9DF85" }
		},
		{
			// Функции и методы.
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": { "foreground": "#8FD0DC" }
		},
		{
			// Классы, типы, интерфейсы.
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
			"settings": { "foreground": "#F5D76E" }
		},
		{
			"scope": ["variable", "meta.variable", "string.variable"],
			"settings": { "foreground": "#E4EAF6" }
		},
		{
			"scope": ["variable.parameter"],
			"settings": { "foreground": "#AEBBE0" }
		},
		{
			"scope": ["variable.other.property", "support.variable.property"],
			"settings": { "foreground": "#A8D8E8" }
		},
		{
			"scope": ["punctuation", "meta.brace", "meta.bracket", "meta.parens"],
			"settings": { "foreground": "#AEBBE0"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#E88F8F" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#F5D76E" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#DE8F8F", "background": "#2A1113" }
		},
		{
			"scope": ["markup.heading"],
			"settings": { "foreground": "#F5D76E" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "" }
		},
		{
			"scope": ["markup.quote"],
			"settings": { "foreground": "#8290B5" }
		},
		{
			"scope": ["markup.inline.raw", "markup.raw"],
			"settings": { "foreground": "#98D08C" }
		}
	]
}
